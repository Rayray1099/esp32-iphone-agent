    "Any OpenAI-compatible vision model works. The key stays in this iPhone's Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何兼容 OpenAI 的视觉模型都可以。密钥只保存在这台 iPhone 的钥匙串里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何相容 OpenAI 的視覺模型都可以。金鑰只儲存在這臺 iPhone 的鑰匙串裡。"
          }
        },
        "zh-TW": {
