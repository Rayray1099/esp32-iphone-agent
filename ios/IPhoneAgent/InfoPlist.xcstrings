    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32 Agent talks to its USB board over Bluetooth to see the screen and move the pointer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ESP32 Agent 通过蓝牙与 USB 开发板通信，用来查看屏幕和移动指针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PULSE 透過藍牙連接 ESP32，設定連點腳本、查看狀態及控制指標。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "PULSE 透過藍牙連接 ESP32，設定連點腳本、查看狀態及控制指標。"
          }
        }
      }
    }
  }
}
