{
  "sourceLanguage": "en",
  "strings": {
    "The run is still active. Return to the Home Screen to continue.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务仍在进行中。请返回手机主屏幕以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務仍在進行中。請返回手機主螢幕以繼續。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "任務仍在進行中。請返回手機主螢幕以繼續。"
          }
        }
      }
    },
    "Paused": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停"
          }
        }
      }
    },
    "The board connection was lost. Move the board closer and keep it powered on, then tap Retry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与板子的连接已断开。请把板子移近并保持供电，然后点击重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與板子的連線已斷開。請把板子移近並保持供電，然後點選重試。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "與板子的連線已斷開。請把板子移近並保持供電，然後點選重試。"
          }
        }
      }
    },
    "The run ended before it could finish. Retry to start again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务未完成便已结束。点击重试重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務未完成便已結束。點選重試重新開始。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "任務未完成便已結束。點選重試重新開始。"
          }
        }
      }
    },
