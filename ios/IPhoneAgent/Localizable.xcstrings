          "stringUnit": {
            "state": "translated",
            "value": "小板的 AirPlay 接收端移植自 UxPlay。"
          }
        }
      }
    },
    "The board's Bluetooth LE stack.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小板的低功耗蓝牙协议栈。"
