    "%lld steps. Check the yellow ones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 步。请确认标黄的步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 步。請確認標黃的步驟。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 步。請確認標黃的步驟。"
          }
        }
      }
    },
    "A .zip with steps, metrics, screenshots, video frames and debug.log, redacted before it is written.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个 .zip，包含步骤、指标、截图、视频帧和 debug.log，写入前已脱敏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個 .zip，包含步驟、指標、截圖、影片幀和 debug.log，寫入前已脫敏。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "一個 .zip，包含步驟、指標、截圖、影片幀和 debug.log，寫入前已脫敏。"
          }
        }
      }
