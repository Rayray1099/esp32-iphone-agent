    "%lld screens captured. Stop when you're done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已抓取 %lld 个画面。做完后点停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已抓取 %lld 個畫面。做完後點停止。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已抓取 %lld 個畫面。做完後點停止。"
          }
